{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": ""
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": " ",
      "format": "{3}"
    },
    {
      "type": "separator",
      "string": "-",
      "times": 37
    },
    {
      "key": "User: ",
      "type": "title",
      "format": "{1}"
    },
    {
      "type": "host",
      "key": "Host: ",
      "format": "{1}"
    },
    {
      "key": "WM: ",
      "type": "wm",
      "format": "{1}"
    },
    {
      "type": "custom",
      "key": "Bar: ",
      "format": "noctalia"
    },
    {
      "key": "Shell: ",
      "type": "shell",
      "format": "{1}"
    },
    {
      "key": "Terminal: ",
      "type": "terminal",
      "format": "{1}"
    },
    {
      "type": "terminalfont",
      "key": "Term Font: ",
      "format": "{2}"
    },
    {
      "type": "custom",
      "key": "Theme: ",
      "format": "Catppuccin Mocha"
    },
    {
      "type": "kernel",
      "key": "Kernel: ",
      "format": "{2}"
    },
    {
      "type": "cpu",
      "key": "CPU: ",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "GPU: ",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "Memory: ",
      "format": "{1}/{2} ({3})"
    },
    {
      "type": "disk",
      "mountpoint": "/",
      "key": "Disk: ",
      "format": "{1}/{2} ({3})"
    },
    {
      "type": "command",
      "key": "Age: ",
      "text": "b=$(stat -c %W / 2>/dev/null); [ \"${b:-0}\" -le 0 ] && b=$(stat -c %Z /); echo \"$(( ($(date +%s) - b) / 86400 )) days\""
    },
    "break",
    {
      "type": "colors"
    },
    "break"
  ]
}
